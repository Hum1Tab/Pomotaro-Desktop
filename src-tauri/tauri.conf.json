{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pomotaro",
  "version": "2.1.0",
  "identifier": "com.pomotaro.app",
  "build": {
    "frontendDist": "../dist/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pomotaro",
        "width": 1200,
        "height": 800,
        "minWidth": 300,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Modern, high-precision Pomodoro timer",
    "longDescription": "A modern, high-precision Pomodoro timer with Discord Rich Presence, session history and a compact focus mode.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0RDMwMjBGMTNGRDY2MTcKUldRWFp2MFREd0xUcEJXb0piZUJZUnFJNDNPSDZpZ2Zaa3ZoeHFwNUFvNXJnTmJvWXk3VExNMkgK",
      "endpoints": [
        "https://github.com/Hum1Tab/Pomotaro-Desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
